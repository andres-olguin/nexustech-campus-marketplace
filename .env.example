# NexusTech Campus Marketplace - Docker Compose Environment
PORT=3000
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=nexustech_development_secret_key_at_least_32_bytes_long
POSTGRES_USER=nexustech
POSTGRES_PASSWORD=nexustech_dev_password
POSTGRES_DB=nexustech
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=nexustech
DATABASE_PASSWORD=nexustech_dev_password
DATABASE_NAME=nexustech
MONGODB_URI=mongodb://mongo:27017/nexustech
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Use a unique URL-safe password for local MongoDB.
MONGO_PASSWORD=replace_with_random_url_safe_password
