{
  "name": "NexusTech API (Node 22 + PostgreSQL + MongoDB)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "forwardPorts": [
    3001
  ],
  "portsAttributes": {
    "3001": {
      "label": "API NexusTech",
      "onAutoForward": "notify"
    }
  },
  "postStartCommand": "bash .devcontainer/start-api.sh"
}
