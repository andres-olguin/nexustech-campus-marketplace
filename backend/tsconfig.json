{
    "compilerOptions":  {
                            "target":  "ES2022",
                            "module":  "Node16",
                            "moduleResolution":  "Node16",
                            "outDir":  "dist",
                            "rootDir":  "src",
                            "strict":  true,
                            "experimentalDecorators":  true,
                            "emitDecoratorMetadata":  true,
                            "esModuleInterop":  true,
                            "skipLibCheck":  true,
                            "ignoreDeprecations":  "6.0",
                            "types":  [
                                          "node"
                                      ]
                        },
    "include":  [
                    "src/**/*.ts",
                    "src/**/*.d.ts"
                ]
}
